import React, { useEffect, useMemo, useState } from 'react';
import OfficerLayout from '../../components/OfficerLayout';
import API from '../../utils/api';

const FILTERS = [
  { value: 'all', label: 'All applications' },
  { value: 'submitted', label: 'Submitted' },
  { value: 'pending', label: 'Pending' },
  { value: 'review', label: 'In review' },
  { value: 'ready', label: 'Ready' },
  { value: 'completed', label: 'Completed' },
  { value: 'rejected', label: 'Rejected' },
];

const STATUS_COLORS = {
  submitted: { bg: '#ede9fe', color: '#6d28d9' },
  pending:   { bg: '#fef3c7', color: '#b45309' },
  review:    { bg: '#fef3c7', color: '#b45309' },
  ready:     { bg: '#e0f2fe', color: '#0369a1' },
  completed: { bg: '#dcfce7', color: '#15803d' },
  rejected:  { bg: '#fee2e2', color: '#b91c1c' },
};

const DEPARTMENTS = [
  { value: 'traffic', label: 'Traffic' },
  { value: 'finance', label: 'Finance' },
  { value: 'pension', label: 'Pension' },
  { value: 'police', label: 'Police' },
  { value: 'passport', label: 'Passport' },
];

const normalizeDepartment = (value) => String(value || '')
  .trim()
  .toLowerCase()
  .replace(/[-\s]+/g, '_')
  .replace(/_?(department|services?|office|officer)$/g, '');

const getRequestDepartment = (request) => (
  request.department ||
  request.department_name ||
  request.service_department ||
  request.assigned_department ||
  request.department_code ||
  ''
);

const Icon = ({ name, size = 18 }) => {
  const c = { width: size, height: size, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', strokeWidth: 1.8, strokeLinecap: 'round', strokeLinejoin: 'round' };
  const p = {
    close: <><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></>,
    doc: <><path d="M6 3.5h8l4 4V20.5H6z" /><path d="M14 3.5v4h4M9 12h6M9 16h6" /></>,
  };
  return <svg {...c}>{p[name]}</svg>;
};

const AdminRequests = () => {
  const [requests, setRequests] = useState([]);
  const [loading, setLoading] = useState(true);
  const [filter, setFilter] = useState('all');
  const [department, setDepartment] = useState('home_affairs');
  const [search, setSearch] = useState('');
  const [error, setError] = useState('');
  const [selected, setSelected] = useState(null);

  const loadRequests = async () => {
    try {
      setLoading(true);
      setError('');
      const responses = await Promise.allSettled([
        API.get('/applications/officer/queue'),
        API.get('/requests/queue'),
      ]);

      const getRows = (response) => {
        const payload = response?.value?.data;
        return Array.isArray(payload)
          ? payload
          : payload?.applications || payload?.requests || payload?.rows || [];
      };

      const applicationRows = responses[0].status === 'fulfilled'
        ? getRows(responses[0]).map((request) => ({ ...request, _source: 'applications' }))
        : [];
      const requestRows = responses[1].status === 'fulfilled'
        ? getRows(responses[1]).map((request) => ({ ...request, _source: 'requests' }))
        : [];

      const merged = [...applicationRows, ...requestRows].map((request) => ({
        ...request,
        department: getRequestDepartment(request),
      }));

      const unique = merged.filter((request, index, all) => index === all.findIndex((item) => (
        String(item.reference_number || '') === String(request.reference_number || '') &&
        item.reference_number
      )));

      setRequests(unique.length ? unique : merged);

      if (!merged.length && responses.every((item) => item.status === 'rejected')) {
        throw responses[0].reason || responses[1].reason;
      }
    } catch (requestError) {
      console.error('Failed to load requests:', requestError);
      setError(requestError.response?.data?.message || 'Unable to load applications. Please try again.');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { loadRequests(); }, []);

  const openApp = async (id) => {
    try {
      const request = requests.find((item) => item.id === id);
      if (!request) return;
      if (request._source === 'requests') {
        setSelected(request);
        return;
      }
      const res = await API.get(`/applications/officer/${id}`);
      setSelected({ ...request, ...res.data });
    } catch (err) {
      alert('Unable to load application details.');
    }
  };

  const handleStatusChange = async (id, status) => {
    try {
      const request = requests.find((item) => item.id === id);
      if (!request || normalizeDepartment(getRequestDepartment(request)) !== 'home_affairs') {
        setError('Home Affairs can view external department applications, but only the assigned department can update their status.');
        return;
      }

      const source = request._source || 'applications';
      if (source === 'requests') {
        await API.put(`/requests/${id}/status`, { status });
      } else {
        await API.put(`/applications/officer/${id}/status`, { status });
      }
      setRequests((current) => current.map((request) => request.id === id ? { ...request, status } : request));
    } catch (requestError) {
      console.error('Unable to update status:', requestError);
      setError(requestError.response?.data?.message || 'Unable to update application status.');
    }
  };

  const filteredRequests = useMemo(() => {
    const query = search.trim().toLowerCase();
    return requests.filter((request) => {
      const matchesDepartment = normalizeDepartment(getRequestDepartment(request)) === department;
      const matchesStatus = filter === 'all' || request.status === filter;
      const matchesSearch = !query || 
        String(request.reference_number || '').toLowerCase().includes(query) || 
        String(request.citizen_name || '').toLowerCase().includes(query) || 
        String(request.citizen_id || '').toLowerCase().includes(query) || 
        String(request.service_type || '').toLowerCase().includes(query) || 
        String(request.department || '').toLowerCase().includes(query);
      return matchesDepartment && matchesStatus && matchesSearch;
    });
  }, [requests, department, filter, search]);

  const metrics = [
    { label: 'Total applications', value: requests.length },
    { label: 'Awaiting action', value: requests.filter((request) => ['submitted', 'pending', 'review'].includes(request.status)).length },
    { label: 'Completed', value: requests.filter((request) => request.status === 'completed').length },
    { label: 'Rejected', value: requests.filter((request) => request.status === 'rejected').length },
  ];

  return (
    <OfficerLayout title="All Applications" subtitle="Home Affairs overview of applications across all government departments.">
      <style>{styles}</style>
      <div className="admin-requests-page">
        <header className="hero">
          <div>
            <div className="eyebrow"><span /> Application operations</div>
            <h1>Government Applications</h1>
            <p>Review, filter, and update applications submitted across the public service system.</p>
          </div>
          <button className="refresh-button" type="button" onClick={loadRequests}>Refresh applications</button>
        </header>

        <section className="metrics" aria-label="Application metrics">
          {metrics.map((metric) => (
            <article className="metric" key={metric.label}>
              <span>{metric.label}</span>
              <strong>{loading ? '—' : metric.value}</strong>
            </article>
          ))}
        </section>

        <section className="filter-panel" aria-label="Application filters">
          <div className="filter-top">
            <div>
              <h2>{department === 'home_affairs' ? 'Home Affairs direct requests' : `${DEPARTMENTS.find((item) => item.value === department)?.label} requests`}</h2>
              <p>Search by reference, citizen, service, or department.</p>
            </div>
            <span>{filteredRequests.length} result{filteredRequests.length === 1 ? '' : 's'}</span>
          </div>
          <div className="department-buttons" role="group" aria-label="Filter by department">
            <button type="button" className={department === 'home_affairs' ? 'department-button department-active' : 'department-button'} onClick={() => setDepartment('home_affairs')}>Home Affairs direct</button>
            {DEPARTMENTS.map((item) => (
              <button type="button" key={item.value} className={department === item.value ? 'department-button department-active' : 'department-button'} onClick={() => setDepartment(item.value)}>{item.label}</button>
            ))}
          </div>
          <div className="search-row">
            <input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="Search applications..." aria-label="Search applications" />
          </div>
          <div className="filter-bar" role="group" aria-label="Filter by application status">
            {FILTERS.map((item) => (
              <button type="button" key={item.value} className={filter === item.value ? 'filter-active' : ''} onClick={() => setFilter(item.value)}>
                {item.label}
              </button>
            ))}
          </div>
        </section>

        {error && <div className="error-message" role="alert">{error}<button type="button" onClick={loadRequests}>Try again</button></div>}

        <section className="dashboard-panel">
          {loading ? (
            <div className="empty-state">Loading applications...</div>
          ) : error ? null : filteredRequests.length === 0 ? (
            <div className="empty-state">No applications match the selected filters.</div>
          ) : (
            <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: 13 }}>
              <thead>
                <tr style={{ background: '#f7f9fc', borderBottom: '1px solid #e5e9f0' }}>
                  <th style={{ textAlign: 'left', padding: '14px 20px', fontSize: 11, fontWeight: 800, color: '#718096', textTransform: 'uppercase', letterSpacing: '.05em' }}>Reference</th>
                  <th style={{ textAlign: 'left', padding: '14px 20px', fontSize: 11, fontWeight: 800, color: '#718096', textTransform: 'uppercase', letterSpacing: '.05em' }}>Citizen</th>
                  <th style={{ textAlign: 'left', padding: '14px 20px', fontSize: 11, fontWeight: 800, color: '#718096', textTransform: 'uppercase', letterSpacing: '.05em' }}>Service</th>
                  <th style={{ textAlign: 'left', padding: '14px 20px', fontSize: 11, fontWeight: 800, color: '#718096', textTransform: 'uppercase', letterSpacing: '.05em' }}>Department</th>
                  <th style={{ textAlign: 'right', padding: '14px 20px', fontSize: 11, fontWeight: 800, color: '#718096', textTransform: 'uppercase', letterSpacing: '.05em' }}>Status</th>
                  <th style={{ textAlign: 'right', padding: '14px 20px', fontSize: 11, fontWeight: 800, color: '#718096', textTransform: 'uppercase', letterSpacing: '.05em' }}>Action</th>
                </tr>
              </thead>
              <tbody>
                {filteredRequests.map((a) => (
                  <tr key={a.id} style={{ borderBottom: '1px solid #f0f2f5' }}>
                    <td style={{ padding: '16px 20px', fontWeight: 800, color: '#00209F' }}>{a.reference_number}</td>
                    <td style={{ padding: '16px 20px', display: 'flex', alignItems: 'center', gap: 10 }}>
                      <span style={{ width: 32, height: 32, borderRadius: '50%', background: '#00209F', color: '#fff', display: 'grid', placeItems: 'center', fontSize: 12, fontWeight: 800, overflow: 'hidden', flexShrink: 0 }}>
                        {a.citizen_picture ? <img src={a.citizen_picture} alt="" style={{ width: '100%', height: '100%', objectFit: 'cover' }} /> : (a.citizen_name || '?').charAt(0).toUpperCase()}
                      </span>
                      {a.citizen_name || a.citizen_id || a.citizen_username || '—'}
                    </td>
                    <td style={{ padding: '16px 20px' }}>{a.service_type}</td>
                    <td style={{ padding: '16px 20px', textTransform: 'capitalize' }}>{a.department?.replace('_', ' ')}</td>
                    <td style={{ padding: '16px 20px', textAlign: 'right' }}>
                      <span style={{ ...STATUS_COLORS[a.status], padding: '4px 10px', borderRadius: 99, fontSize: 11, fontWeight: 800, textTransform: 'capitalize' }}>
                        {a.status}
                      </span>
                    </td>
                    <td style={{ padding: '16px 20px', textAlign: 'right' }}>
                      <button 
                        onClick={() => openApp(a.id)}
                        style={{ padding: '7px 12px', background: '#00209F', color: '#fff', border: 'none', borderRadius: 8, fontSize: 11.5, fontWeight: 800, cursor: 'pointer' }}
                      >
                        View →
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </section>

        {/* DETAIL MODAL WITH DOCUMENTS */}
        {selected && (
          <div className="overlay" onClick={() => setSelected(null)}>
            <div className="modal" onClick={(e) => e.stopPropagation()}>
              <div className="modal-head">
                <div>
                  <h2>{selected.service_type}</h2>
                  <p>Ref: <strong>{selected.reference_number}</strong> · {selected.department?.replace('_', ' ')}</p>
                </div>
                <button className="close" onClick={() => setSelected(null)}><Icon name="close" size={20} /></button>
              </div>
              <div className="modal-body">
                <div className="applicant-card">
                  <div className="applicant-avatar">
                    {selected.citizen_picture ? <img src={selected.citizen_picture} alt="" /> : (selected.citizen_name || '?').charAt(0).toUpperCase()}
                  </div>
                  <div style={{ minWidth: 0, flex: 1 }}>
                    <div className="applicant-name">{selected.citizen_name || '—'}</div>
                    <div className="applicant-meta">
                      {selected.citizen_id ? `ID: ${selected.citizen_id}` : ''}
                      {selected.citizen_username ? ` · @${selected.citizen_username}` : ''}
                    </div>
                  </div>
                </div>

                {selected.form_data && Object.keys(selected.form_data).length > 0 && (
                  <div className="detail-section">
                    <h3>Application details</h3>
                    <div className="field-grid">
                      {Object.entries(selected.form_data).map(([k, v]) => (
                        <div className="field" key={k}>
                          <label>{k.replace(/_/g, ' ')}</label>
                          <div>{String(v || '—')}</div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* Documents */}
                {selected.documents && selected.documents.length > 0 ? (
                  <div className="detail-section">
                    <h3>Supporting documents ({selected.documents.length})</h3>
                    <div className="doc-list">
                      {selected.documents.map((d) => (
                        <div className="doc" key={d.id}>
                          <span><Icon name="doc" size={14} /> <strong>{d.file_name}</strong> ({d.file_size ? Math.round(d.file_size / 1024) : 0} KB)</span>
                          <a href={d.file_data} download={d.file_name}>Download ↓</a>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : (
                  <div className="detail-section">
                    <h3>Supporting documents</h3>
                    <div style={{ padding: '14px', background: '#f7f9fc', border: '1px dashed #cbd5e1', borderRadius: '10px', color: '#718096', fontSize: '13px', textAlign: 'center' }}>
                      No supporting documents uploaded with this application.
                    </div>
                  </div>
                )}

                {/* Status update */}
                <div className="detail-section">
                  <h3>Update status</h3>
                    <select
                      value={selected.status}
                      disabled={normalizeDepartment(getRequestDepartment(selected)) !== 'home_affairs'}
                      onChange={(e) => {
                        handleStatusChange(selected.id, e.target.value);
                        setSelected({ ...selected, status: e.target.value });
                    }}
                    style={{ padding: '10px 14px', borderRadius: 10, border: '1px solid #e5e9f0', fontSize: 13, background: '#fff', width: '100%' }}
                      >
                    <option value="submitted">Submitted</option>
                    <option value="pending">Pending</option>
                    <option value="review">In review</option>
                    <option value="ready">Ready</option>
                    <option value="completed">Completed</option>
                    <option value="rejected">Rejected</option>
                      </select>
                      {normalizeDepartment(getRequestDepartment(selected)) !== 'home_affairs' && (
                        <p style={{ marginTop: 9, color: '#718096', fontSize: 12 }}>
                          Read-only: the assigned department is responsible for updating this application.
                        </p>
                      )}
                </div>
              </div>
              <div className="modal-foot">
                <button className="btn-secondary" onClick={() => setSelected(null)}>Close</button>
              </div>
            </div>
          </div>
        )}
      </div>
    </OfficerLayout>
  );
};

const styles = `
  .admin-requests-page { --blue:#00209F; --blue-dark:#00166f; --blue-soft:#edf2ff; --green:#009543; --green-soft:#eaf8f0; --black:#000; --ink:#172235; --muted:#718096; --border:#e5e9f0; --white:#fff; width:100%; max-width:1440px; margin:0 auto; color:var(--ink); }
  .admin-requests-page * { box-sizing:border-box; }
  .admin-requests-page h1,.admin-requests-page h2,.admin-requests-page p { margin:0; }
  .admin-requests-page button,.admin-requests-page input { font:inherit; }
  .admin-requests-page button { cursor:pointer; }
  .admin-requests-page .hero { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:24px; }
  .admin-requests-page .eyebrow { display:flex; align-items:center; gap:8px; margin-bottom:9px; color:var(--blue); font-size:10px; font-weight:800; letter-spacing:.13em; text-transform:uppercase; }
  .admin-requests-page .eyebrow span { width:8px; height:8px; border-radius:50%; background:var(--green); box-shadow:0 0 0 5px var(--green-soft); }
  .admin-requests-page h1 { color:var(--black); font-size:clamp(25px,3vw,34px); line-height:1.1; letter-spacing:-.04em; }
  .admin-requests-page .hero p { margin-top:8px; color:var(--muted); font-size:13px; line-height:1.5; }
  .admin-requests-page .refresh-button { min-height:40px; padding:0 14px; color:var(--blue); border:1px solid #cbd6f2; border-radius:10px; background:var(--white); font-size:11px; font-weight:800; }
  .admin-requests-page .refresh-button:hover { background:var(--blue-soft); }
  .admin-requests-page .metrics { display:grid; grid-template-columns:repeat(4,1fr); gap:13px; margin-bottom:19px; }
  .admin-requests-page .metric { padding:16px; border:1px solid var(--border); border-radius:14px; background:var(--white); box-shadow:0 7px 20px rgba(20,35,60,.04); }
  .admin-requests-page .metric span { display:block; color:var(--muted); font-size:10px; font-weight:800; }
  .admin-requests-page .metric strong { display:block; margin-top:5px; color:var(--black); font-size:25px; line-height:1; }
  .admin-requests-page .filter-panel,.admin-requests-page .dashboard-panel { border:1px solid var(--border); border-radius:16px; background:var(--white); box-shadow:0 7px 20px rgba(20,35,60,.045); }
  .admin-requests-page .filter-panel { padding:19px; }
  .admin-requests-page .filter-top { display:flex; align-items:flex-end; justify-content:space-between; gap:14px; }
  .admin-requests-page .filter-top h2 { color:var(--black); font-size:16px; }
  .admin-requests-page .filter-top p { margin-top:5px; color:var(--muted); font-size:11px; }
  .admin-requests-page .filter-top > span { color:var(--blue); font-size:11px; font-weight:800; }
  .admin-requests-page .department-buttons { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:8px; margin-top:16px; }.admin-requests-page .department-button { min-height:38px; padding:0 9px; color:var(--muted); border:1px solid var(--border); border-radius:10px; background:var(--white); font-size:11px; font-weight:800; transition:.18s ease; }.admin-requests-page .department-button:hover { color:var(--blue); border-color:#b9c9ee; background:var(--blue-soft); }.admin-requests-page .department-button.department-active { color:var(--white); border-color:var(--blue); background:var(--blue); box-shadow:0 5px 12px rgba(0,32,159,.16); }.admin-requests-page .search-row { margin-top:15px; }
  .admin-requests-page .search-row input { width:100%; min-height:42px; padding:0 13px; color:var(--ink); border:1px solid var(--border); border-radius:10px; outline:none; background:#fbfcff; font-size:12px; }
  .admin-requests-page .search-row input:focus { border-color:#a9bde9; box-shadow:0 0 0 3px var(--blue-soft); }
  .admin-requests-page .filter-bar { display:flex; flex-wrap:wrap; gap:7px; margin-top:13px; }
  .admin-requests-page .filter-bar button { min-height:32px; padding:0 12px; color:var(--muted); border:1px solid var(--border); border-radius:99px; background:var(--white); font-size:10px; font-weight:800; }
  .admin-requests-page .filter-bar button:hover,.admin-requests-page .filter-bar .filter-active { color:var(--white); border-color:var(--blue); background:var(--blue); }
  .admin-requests-page .error-message { display:flex; align-items:center; justify-content:space-between; gap:15px; margin-top:15px; padding:12px 14px; color:#9b3d3d; border:1px solid #f0caca; border-radius:10px; background:#fff3f3; font-size:12px; }
  .admin-requests-page .error-message button { color:#9b3d3d; border:0; background:transparent; font-size:11px; font-weight:800; text-decoration:underline; }
  .admin-requests-page .dashboard-panel { overflow:auto; margin-top:19px; padding:4px; }
  .admin-requests-page .dashboard-panel > * { min-width:800px; }
  .admin-requests-page .empty-state { min-width:0 !important; padding:54px 20px; color:var(--muted); text-align:center; font-size:12px; }

  /* MODAL STYLES */
  .admin-requests-page .overlay { position:fixed; inset:0; background:rgba(10,20,40,.55); display:flex; align-items:center; justify-content:center; padding:20px; z-index:1000; }
  .admin-requests-page .modal { background:#fff; border-radius:18px; width:min(720px,100%); max-height:90vh; overflow-y:auto; box-shadow:0 30px 80px rgba(0,0,0,.25); }
  .admin-requests-page .modal-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding:24px 26px 18px; border-bottom:1px solid var(--border); }
  .admin-requests-page .modal-head h2 { font-size:19px; }
  .admin-requests-page .modal-head p { margin-top:6px; color:var(--muted); font-size:12.5px; }
  .admin-requests-page .close { background:transparent; border:none; color:var(--muted); padding:6px; }
  .admin-requests-page .modal-body { padding:22px 26px; }
  .admin-requests-page .applicant-card { display:flex; align-items:center; gap:14px; padding:14px; background:#f7f9fc; border:1px solid var(--border); border-radius:12px; margin-bottom:20px; }
  .admin-requests-page .applicant-avatar { width:52px; height:52px; border-radius:50%; background:var(--blue); color:#fff; display:grid; place-items:center; font-size:20px; font-weight:800; overflow:hidden; flex-shrink:0; }
  .admin-requests-page .applicant-avatar img { width:100%; height:100%; object-fit:cover; }
  .admin-requests-page .applicant-name { font-size:15px; font-weight:800; color:var(--ink); }
  .admin-requests-page .applicant-meta { font-size:12px; color:var(--muted); margin-top:3px; }
  .admin-requests-page .detail-section { margin-bottom:20px; }
  .admin-requests-page .detail-section h3 { font-size:12px; font-weight:800; color:var(--blue); text-transform:uppercase; letter-spacing:.1em; margin-bottom:12px; padding-bottom:8px; border-bottom:1px solid var(--border); }
  .admin-requests-page .field-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; }
  .admin-requests-page .field label { display:block; font-size:11px; font-weight:800; color:var(--muted); margin-bottom:4px; text-transform:capitalize; }
  .admin-requests-page .field div { font-size:13.5px; color:var(--ink); }
  .admin-requests-page .doc-list { display:grid; gap:8px; }
  .admin-requests-page .doc { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:#f7f9fc; border:1px solid var(--border); border-radius:10px; font-size:12.5px; }
  .admin-requests-page .doc a { color:var(--blue); text-decoration:none; font-size:11.5px; font-weight:800; }
  .admin-requests-page .modal-foot { padding:18px 26px 22px; border-top:1px solid var(--border); display:flex; justify-content:flex-end; }
  .admin-requests-page .btn-secondary { padding:11px 20px; border-radius:10px; font-size:13px; font-weight:800; background:#fff; color:var(--blue); border:1px solid #cbd6f2; }
`;

export default AdminRequests;
